{
  "opencollection": "1.0.0",
  "info": {
    "name": "Terminal Shop Address Token API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.terminal.shop/token"
          },
          "docs": "List the personal access tokens associated with the current user."
        },
        {
          "info": {
            "name": "Create token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.terminal.shop/token"
          },
          "docs": "Create a personal access token. The secret is returned only once at creation time."
        },
        {
          "info": {
            "name": "Get token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.terminal.shop/token/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the personal access token with the given ID."
        },
        {
          "info": {
            "name": "Delete token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.terminal.shop/token/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete the personal access token with the given ID."
        }
      ]
    }
  ],
  "bundled": true
}