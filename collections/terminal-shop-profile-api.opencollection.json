{
  "opencollection": "1.0.0",
  "info": {
    "name": "Terminal Shop Address Profile API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.terminal.shop/profile"
          },
          "docs": "Get the current user's profile."
        },
        {
          "info": {
            "name": "Update profile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.terminal.shop/profile",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the current user's name and email."
        }
      ]
    }
  ],
  "bundled": true
}