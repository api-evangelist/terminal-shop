{
  "opencollection": "1.0.0",
  "info": {
    "name": "Terminal Shop Address Product API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Product",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.terminal.shop/product"
          },
          "docs": "List all products for sale in the Terminal shop."
        },
        {
          "info": {
            "name": "Get product",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.terminal.shop/product/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a product by ID from the Terminal shop."
        }
      ]
    }
  ],
  "bundled": true
}